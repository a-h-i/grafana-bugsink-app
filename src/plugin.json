{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Bugsink",
  "id": "ahmedismail-bugsink-app",
  "info": {
    "keywords": ["bugsink", "sentry", "errors", "error tracking"],
    "description": "Browse and triage Bugsink issues in Grafana, with links from an error event to its trace and logs",
    "author": {
      "name": "Ahmed Ismail"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      { "name": "Issue list", "path": "img/screenshots/issue-list.png" },
      { "name": "Issue page with triage actions", "path": "img/screenshots/issue-detail.png" },
      { "name": "Event detail", "path": "img/screenshots/event-detail.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Bugsink",
      "path": "/a/%PLUGIN_ID%",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "datasource",
      "name": "Bugsink",
      "path": "datasource/plugin.json"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
